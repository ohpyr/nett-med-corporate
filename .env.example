# --- Required in production -------------------------------------------------
# adapter-node needs to know its own public origin. Without it SvelteKit
# cannot validate the Origin header on form posts and every quote submission
# is rejected with 403.
ORIGIN=https://nett-med.ca

# Port the Node server listens on.
PORT=3000

# --- Lead capture -----------------------------------------------------------
# Append-only record of every quote request. This is the source of truth: a
# submission is written here before any notification is attempted.
LEADS_FILE=data/leads.jsonl

# --- Optional: email notification -------------------------------------------
# Any SMTP provider. If these are unset, leads are still captured to the file
# above; only the notification is skipped.
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=nett-med@hotmail.com
# SMTP_PASS=
# SMTP_FROM=nett-med@hotmail.com
# LEAD_NOTIFY_TO=nett-med@hotmail.com

# --- Optional: webhook notification -----------------------------------------
# Posts the lead as JSON. Works with Discord, Slack, Telegram bridges, n8n.
# Useful as a phone notification without running mail.
# LEAD_WEBHOOK_URL=
